# Copy to .env and fill in. See docs/prds/14-devops-local-environment.md §5.4.
# Values below are safe non-secret placeholders for local dev only.

# --- Database (PRD 14 §5.1, base doc §7.4) ---
POSTGRES_USER=peakform
POSTGRES_PASSWORD=peakform_dev
POSTGRES_DB=peakform
DATABASE_URL=postgresql://peakform:peakform_dev@postgres:5432/peakform?schema=public

# --- Redis (base doc §7.5) ---
REDIS_URL=redis://redis:6379

# --- Auth / JWT (PRD 01 §5.3) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
NEXTAUTH_SECRET=dev_nextauth_secret_change_me
NEXTAUTH_URL=http://localhost:3000
# Server-side base URL the web app uses to reach the API (docker service name inside compose, localhost for host dev)
API_BASE_URL=http://api:3001

# --- Google OAuth (PRD 01 §5.1/§5.3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage / Minio (S3-compatible, base doc §7.6) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=peakform_minio
S3_SECRET_KEY=peakform_minio_secret
S3_BUCKET=peakform-media
S3_REGION=us-east-1
# Browser-facing base for media URLs (the API writes to S3_ENDPOINT, which is
# the compose-internal hostname; browsers resolve localhost:9000 in dev).
S3_PUBLIC_URL=http://localhost:9000

# --- Mail catcher (PRD 14 §5.1) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@peakform.local

# --- External food APIs (base doc §8.2, PRD 08 §5.3) ---
USDA_FOODDATA_API_KEY=
# TACO API (self-hosted via docker-compose; service name inside compose,
# localhost:4000 for host dev). Leave empty to disable TACO search.
TACO_API_URL=http://taco-api:4000/graphql

# --- Web push / VAPID (PRD 12 §5.2) ---
# Optional channel: leave unset and push delivery silently skips itself
# (email-only, no error). Generate a dev pair with:
#   node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:no-reply@peakform.local

# --- App ports ---
PORT=3001
WEB_BASE_URL=http://localhost:3000

# Auth throttle overrides for local dev/BDD (defaults: signup=10, login=5,
# reset-request=5, oauth=10 per 60s window — production leaves these unset).
AUTH_THROTTLE_SIGNUP_LIMIT=100
AUTH_THROTTLE_LOGIN_LIMIT=100
AUTH_THROTTLE_RESET_REQUEST_LIMIT=100
AUTH_THROTTLE_OAUTH_LIMIT=100
