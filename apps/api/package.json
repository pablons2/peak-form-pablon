    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/throttler": "^6.2.1",
    "@peakform/shared-types": "*",
    "@peakform/validation": "*",
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^9.15.1",
