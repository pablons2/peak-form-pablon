// PeakForm — Prisma schema
// Models are added module by module, in the order tracked in
// docs/IMPLEMENTATION_CHECKLIST.md (PRD 01 first). Do not add a model here
// before its owning PRD's "Backend" checklist item is being worked on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- PRD 01: Authentication & Account Management -------------------------

enum Role {
  ADMIN
  PROFESSIONAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum Specialization {
  PERSONAL_TRAINER
  NUTRITIONIST
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BiologicalSex {
  MALE
  FEMALE
}

/// Base identity for every persona (base doc §6). `fullName` is not listed
/// explicitly on User in PRD 01 §6 (only called out as a Professional signup
/// field there), but every persona needs a display name — messaging (PRD 11),
/// the admin console (PRD 13), and professional/client lists (PRD 02) all
/// depend on it — so it lives here as a base field rather than being
/// duplicated per-role.
model User {
  id                         String     @id @default(cuid())
  email                      String     @unique
  fullName                   String
  passwordHash               String?
  oauthProviders             String[]   @default([])
  role                       Role
  status                     UserStatus @default(ACTIVE)
  emailVerifiedAt            DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  /// Time-limited email-verification token (PRD 01 §5.2). Stored as a hash,
  /// never the raw token, per base doc §9's secrets-handling guidance — the
  /// raw token only ever exists in the emailed link. No new top-level entity
  /// per PRD 01 §6, so these live as fields on User rather than their own table.
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  /// Time-limited password-reset token (PRD 01 §5.4), same hash-not-raw rule.
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?

  /// Bumped on every password reset; a JWT's embedded version must match this
  /// or the token is rejected. This is how "password reset invalidates all
  /// prior sessions" (PRD 01 §10) is enforced against stateless access/refresh
  /// JWTs without a server-side session table.
  tokenVersion               Int        @default(0)

  professionalProfile        ProfessionalProfile?
  clientProfile               ClientProfile?

  /// Professional accounts this user approved/rejected as Admin (PRD 01 §5.6).
  approvalDecisions          ProfessionalProfile[] @relation("ApprovalActor")

  /// PRD 02 — links where this user is the Professional / Client side, links
  /// this user unlinked, and check-in schedules this user created.
  professionalLinks         ProfessionalClientLink[] @relation("LinkProfessional")
  clientLinks               ProfessionalClientLink[] @relation("LinkClient")
  unlinkedLinks             ProfessionalClientLink[] @relation("LinkUnlinker")
  createdCheckInSchedules   CheckInSchedule[]        @relation("CheckInScheduleCreator")

  /// PRD 05 — custom (private) exercises this user authored. Admin-authored
  /// customs land here too when created through the custom endpoints.
  ownedExercises             Exercise[]              @relation("ExerciseOwner")

  /// PRD 03 — this Client's own versioned intake submissions, and clinical
  /// notes this Professional authored on (any) Client's intake.
  intakeAssessments          IntakeAssessment[]       @relation("IntakeClient")
  professionalAnnotations    ProfessionalAnnotation[] @relation("IntakeAnnotationAuthor")

  /// PRD 06 — plans this user is the Client of, plans this user authored as
  /// the assigned Professional, and Starter Templates this user authored
  /// (Professional or Admin) — exactly one of professionalId/authoredById is
  /// set on a given TrainingPlan (PRD 06 §6).
  trainingPlansAsClient       TrainingPlan[] @relation("TrainingPlanClient")
  trainingPlansAsProfessional TrainingPlan[] @relation("TrainingPlanProfessional")
  authoredTrainingPlans       TrainingPlan[] @relation("TrainingPlanAuthor")

  /// PRD 04 — this Client's own append-only measurement history, and formal
  /// assessments this Professional/Admin validated on (any) Client's history.
  bodyAssessments          BodyAssessment[] @relation("BodyAssessmentClient")
  validatedBodyAssessments BodyAssessment[] @relation("BodyAssessmentValidator")

  /// PRD 08 — this Client's own nutrition targets/food diary/hydration, and
  /// plans this Nutritionist authored/confirmed for (any) Client.
  nutritionPlansAsClient       NutritionPlan[]   @relation("NutritionPlanClient")
  nutritionPlansAsNutritionist NutritionPlan[]   @relation("NutritionPlanNutritionist")
  foodDiaryEntries             FoodDiaryEntry[]  @relation("FoodDiaryEntryClient")
  hydrationLogs                HydrationLog[]    @relation("HydrationLogClient")

  /// PRD 11 — message threads this user is a party to (one side or the
  /// other), and messages this user sent across any thread.
  messageThreadsAsProfessional MessageThread[] @relation("MessageThreadProfessional")
  messageThreadsAsClient       MessageThread[] @relation("MessageThreadClient")
  sentMessages                 Message[]       @relation("MessageSender")

  /// PRD 10 — this Client's own health-adjacent habit definitions (their
  /// check-ins hang off the definitions) and personal tasks. Client-only
  /// by design (§4): nothing here is visible to Professionals or Admin.
  habitDefinitions             HabitDefinition[] @relation("HabitClient")
  personalTasks                PersonalTask[]    @relation("PersonalTaskClient")

  /// PRD 12 — this user's in-app notification list, per-type channel
  /// preferences, and browser push subscriptions.
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  pushSubscriptions        PushSubscription[]

  auditLogEntries            AuditLog[]

  @@map("users")
}

/// 1:1 with a PROFESSIONAL User (PRD 01 §6).
model ProfessionalProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations  Specialization[]
  approvalStatus   ApprovalStatus  @default(PENDING_APPROVAL)
  verificationNote String
  approvedById     String?
  approvedBy       User?           @relation("ApprovalActor", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("professional_profiles")
}

/// 1:1 with a CLIENT User (PRD 01 §6). dateOfBirth/biologicalSex are required
/// — they feed PRD 04's Jackson & Pollock formula and PRD 08's Mifflin-St
/// Jeor estimate; age is always computed from dateOfBirth at calculation
/// time, never stored, so no separate "age" field exists here.
model ClientProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth   DateTime      @db.Date
  biologicalSex BiologicalSex
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("client_profiles")
}

/// Append-only compliance/accountability trail (base doc §6, §9). First
/// consumer is PRD 01 §5.6 (approval/rejection decisions); later modules
/// (PRD 02 force-unlink, PRD 06 contraindication overrides, PRD 13 admin
/// actions) write to the same table rather than each owning their own log.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}


// --- PRD 02: Professional ↔ Client Relationship ---------------------------

enum LinkStatus {
  PENDING
  ACTIVE
  DECLINED
  EXPIRED
  UNLINKED
}

enum LinkInvitedBy {
  PROFESSIONAL
  CLIENT
}

/// The working relationship between a Professional and a Client for one
/// specialization (PRD 02 §6). The invite/request IS this row in PENDING;
/// it goes straight to ACTIVE on acceptance (no separate ACCEPTED status).
/// "At most one ACTIVE row per (clientId, specialization)" (PRD 02 §6) is
/// enforced in the Application layer (§5.3) rather than as a DB constraint,
/// because history rows (DECLINED/EXPIRED/UNLINKED) for the same key are
/// legitimate and a partial unique index isn't expressible here.
model ProfessionalClientLink {
  id             String         @id @default(cuid())
  professionalId String
  professional   User           @relation("LinkProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  clientId       String
  client         User           @relation("LinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  specialization Specialization
  status         LinkStatus     @default(PENDING)
  invitedBy      LinkInvitedBy

  /// PENDING invites auto-expire to EXPIRED after 30 days (PRD 02 §5.1);
  /// cleared on acceptance.
  expiresAt DateTime?

  linkedAt     DateTime?
  unlinkedAt   DateTime?
  unlinkedById String?
  unlinkedBy   User?     @relation("LinkUnlinker", fields: [unlinkedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkInSchedules CheckInSchedule[]

  @@unique([professionalId, clientId])
  @@index([clientId, specialization, status])
  @@index([professionalId, status])
  @@map("professional_client_links")
}

enum CheckInScheduleType {
  ONE_OFF
  RECURRING
}

enum CheckInCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum CheckInScheduleStatus {
  ACTIVE
  FIRED
  CANCELLED
}

/// Check-in reminder owned by PRD 02 §5.6, scoped to one
/// ProfessionalClientLink (a PT and a Nutritionist schedule independently).
/// `nextDueAt` is the firing job's query target (status ACTIVE + due) and the
/// single source of truth PRD 09's dashboard and PRD 12's notification both read.
model CheckInSchedule {
  id     String              @id @default(cuid())
  linkId String
  link   ProfessionalClientLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  type    CheckInScheduleType
  /// Required only for RECURRING (WEEKLY/BIWEEKLY: weekday 0-6; MONTHLY:
  /// day-of-month 1-31, clamped to the month's length in date-math).
  cadence CheckInCadence?
  anchor  Int?
  /// Required only for ONE_OFF.
  dueDate DateTime?
  /// Computed from cadence+anchor (RECURRING) or dueDate (ONE_OFF); indexed
  /// because this is what the firing job queries (PRD 02 §5.6).
  nextDueAt DateTime?
  note      String?
  status    CheckInScheduleStatus @default(ACTIVE)

  createdById String
  /// Cascade (not the Prisma default Restrict): a CheckInSchedule's `link`
  /// FK already cascades from either party via ProfessionalClientLink, so a
  /// Restrict here would still block that same delete outright the moment
  /// the creator (always one of the link's two parties) is the target —
  /// conflicting FK actions on the same row, not two independent rules.
  createdBy User @relation("CheckInScheduleCreator", fields: [createdById], references: [id], onDelete: Cascade)

  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextDueAt])
  @@index([linkId, status])
  @@map("check_in_schedules")
}


// --- PRD 05: Exercise Library ------------------------------------------------

enum ExerciseVisibility {
  GLOBAL
  PRIVATE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Controlled vocabularies for §5.4's search/filter — mirrored by the shared
// zod enums in packages/validation (same pattern as Specialization). Kept as
// DB enums so imported/custom rows can never drift into free-text values the
// filters would silently miss.
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  GLUTES
  QUADRICEPS
  HAMSTRINGS
  CALVES
  FULL_BODY
}

enum Equipment {
  BODYWEIGHT
  DUMBBELL
  BARBELL
  KETTLEBELL
  RESISTANCE_BAND
  CABLE
  MACHINE
  MEDICINE_BALL
  BENCH
  PULL_UP_BAR
  STABILITY_BALL
  FOAM_ROLLER
}

/// The contraindication vocabulary this module owns canonically (PRD 05 §2/§6).
/// PRD 03 stores references to these `code` values on a Client's intake
/// profile and PRD 06 cross-references them when flagging contraindicated
/// prescriptions — it is a reference table, not an enum, because Admins
/// extend it over time and rows carry display copy (label/description).
/// Seeded by the prd05 migration's INSERTs (reference data, not a runtime
/// import), so every environment gets the same vocabulary deterministically.
model ContraindicationTag {
  code        String  @id
  label       String
  description String
  exercises   Exercise[]

  @@map("contraindication_tags")
}

/// One catalog entry (PRD 05 §6 / base doc §3.3). Two provenances share the
/// table: imported catalog rows (GLOBAL, sourceApiId+sourceHash set, no
/// owner) and Professional/Admin-authored customs (PRIVATE, owned, no
/// sourceApiId). Promotion flips visibility GLOBAL and clears the owner —
/// §6's "ownerProfessionalId null for global" is enforced, with the
/// previous owner kept in the promotion's audit-log metadata.
model Exercise {
  id           String              @id @default(cuid())
  name         String
  /// URL of the movement's GIF/video in our own object storage (PRD 05 §5.1 —
  /// never the source dataset's host). Nullable because §5.3 doesn't require
  /// Professionals to supply media for a custom exercise.
  mediaUrl     String?
  muscleGroups MuscleGroup[]
  equipment    Equipment[]
  difficulty   Difficulty
  cues         String[]
  mistakes     String[]

  contraindicationTags ContraindicationTag[]

  /// Stable external id from the imported dataset — the idempotency key for
  /// §5.1's re-runnable import. Unique; null for authored exercises.
  sourceApiId String? @unique
  /// SHA-256 of the normalized dataset entry. A re-import whose entry hash
  /// matches skips the row entirely (no update write, no media re-upload).
  sourceHash  String?

  ownerProfessionalId String?
  ownerProfessional   User?   @relation("ExerciseOwner", fields: [ownerProfessionalId], references: [id], onDelete: Cascade)
  visibility          ExerciseVisibility @default(GLOBAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// PRD 06 — prescriptions referencing this exercise, in a weekly template
  /// or a dated Session. No `onDelete` override (defaults to Restrict): once
  /// a Client has a plan or logged history built on this exercise, deleting
  /// it out from under that history would corrupt the record — the delete
  /// use-cases surface this as a 409, not a 500 (see
  /// PrismaExerciseRepository.delete).
  weeklyMicrocycleTemplateExercises WeeklyMicrocycleTemplateExercise[]
  sessionExercises                  SessionExercise[]

  @@index([visibility, ownerProfessionalId])
  @@map("exercises")
}


// --- PRD 03: Onboarding / Intake (Anamnesis + PAR-Q) -----------------------

enum IntakeStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED_WITH_ACKNOWLEDGEMENT
}

// Fixed body-map vocabulary for the front/back silhouette picker (PRD 03
// §5.1/§7). Kept as a DB enum (not free text) so the Domain-layer
// contraindication rule set (§5.2) can pattern-match deterministically —
// same rationale as PRD 05's MuscleGroup/Equipment enums. PAR-Q question
// codes are NOT a DB enum (they key the parqAnswers JSON blob) — they live
// as a Domain-layer constant instead (src/intake/domain/par-q-questions.ts)
// so a PT/physiotherapist can revise wording later (§9 open question)
// without a migration.
enum BodyRegion {
  NECK
  SHOULDER_LEFT
  SHOULDER_RIGHT
  UPPER_BACK
  LOWER_BACK
  CHEST
  ABDOMEN
  HIP_LEFT
  HIP_RIGHT
  ELBOW_LEFT
  ELBOW_RIGHT
  WRIST_LEFT
  WRIST_RIGHT
  KNEE_LEFT
  KNEE_RIGHT
  ANKLE_LEFT
  ANKLE_RIGHT
}

enum MedicalCondition {
  DIABETES
  CARDIOVASCULAR_DISEASE
  HYPERTENSION
  ASTHMA_OR_RESPIRATORY
  PREGNANCY
  OTHER
}

enum PainRecency {
  PAST
  CURRENT
}

/// One versioned intake submission (PRD 03 §5.3/§6) — Client-authored fields
/// only. A new version is started rather than editing a COMPLETED/SKIPPED
/// row in place (§5.3); ProfessionalAnnotation rows stay tied to whichever
/// version they were written against, so they're never overwritten by a
/// later resubmission (§5.4). `contraindicationTagCodes` is derived at
/// completion/skip time by the Domain-layer rule set (§5.2) from
/// parqAnswers/painFlags/medicalConditions and only ever references PRD 05's
/// ContraindicationTag.code vocabulary — this module defines no tags of its
/// own (base doc §5 resolved coupling).
model IntakeAssessment {
  id       String       @id @default(cuid())
  clientId String
  client   User         @relation("IntakeClient", fields: [clientId], references: [id], onDelete: Cascade)
  version  Int
  status   IntakeStatus @default(IN_PROGRESS)

  /// Keyed by a fixed PAR-Q question code (domain/par-q-questions.ts) →
  /// boolean answer. Json rather than fixed columns for the same
  /// revise-without-migration reason the question set isn't a DB enum.
  parqAnswers Json?

  /// Body-map pain flags (§5.1/§6) — a real related table, not Json, so the
  /// BodyRegion enum stays genuinely enforced at the DB level and queryable
  /// (unlike parqAnswers/equipmentAccess, which are free-form enough that
  /// Json is the better fit, this is exactly the structured, safety-critical
  /// data the contraindication rule set (§5.2) reads directly).
  painFlags PainFlag[]

  medicalConditions          MedicalCondition[] @default([])
  /// Free-text "other" field for the medical-conditions checklist (§5.1) —
  /// not itemized in §6's field list, added alongside `medications` for the
  /// same reason PRD 01's User.fullName was: the UX requirement (§5.1's
  /// "checklist ... with an 'other' free-text field") needs somewhere to live.
  medicalConditionsOtherNote String?
  medications                String?

  /// { daysPerWeek: number, sessionDurationMinutes: number }
  availability Json?
  /// { location: "HOME"|"GYM", homeEquipment: string[] }
  equipmentAccess Json?

  contraindicationTagCodes String[] @default([])

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  annotations ProfessionalAnnotation[]

  @@unique([clientId, version])
  @@index([clientId, status])
  @@map("intake_assessments")
}

/// One flagged body region on one intake version (PRD 03 §5.1/§6). A version
/// is finalized (or re-saved) by replacing its whole set — deleteMany+create
/// in the same transaction, same "set replaces wholesale" pattern PRD 05
/// uses for Exercise.contraindicationTags.
model PainFlag {
  id                 String           @id @default(cuid())
  intakeAssessmentId String
  intakeAssessment   IntakeAssessment @relation(fields: [intakeAssessmentId], references: [id], onDelete: Cascade)
  region             BodyRegion
  /// 0-10 self-reported pain scale (§5.1).
  severity           Int
  pastOrCurrent      PainRecency

  @@index([intakeAssessmentId])
  @@map("pain_flags")
}

/// Professional clinical note tied to one specific intake version (PRD 03
/// §5.4/§6) — its own record, never overwritten by the Client's next
/// self-reported update.
model ProfessionalAnnotation {
  id                 String           @id @default(cuid())
  intakeAssessmentId String
  intakeAssessment   IntakeAssessment @relation(fields: [intakeAssessmentId], references: [id], onDelete: Cascade)
  professionalId     String
  professional       User             @relation("IntakeAnnotationAuthor", fields: [professionalId], references: [id], onDelete: Cascade)
  note               String
  createdAt          DateTime @default(now())

  @@index([intakeAssessmentId])
  @@map("professional_annotations")
}


// --- PRD 06: Training Plan Builder ------------------------------------------

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

// Base doc §5.6 / PRD 06 §5.2 lists "goal (free text or enum)" — chosen as an
// enum for the same reason PRD 05's Difficulty is one: a fixed vocabulary
// keeps filtering/reporting possible later without free-text drift.
enum MesocycleGoal {
  HYPERTROPHY
  STRENGTH
  ENDURANCE
  POWER
  GENERAL_FITNESS
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

/// The periodized plan root (PRD 06 §6). Exactly one of `professionalId`
/// (a concrete assignment) or `authoredById` (a Starter Template, §5.8) is
/// set at all times — enforced in the Application layer (base doc §7.2),
/// not a DB constraint (Postgres has no portable "exactly one of two
/// nullable columns" check short of a CHECK expression this schema doesn't
/// otherwise use). `clientId` follows the same one-or-the-other rule as
/// `professionalId`: both null together (Starter Template) or both set
/// together (assigned plan) — a self-assigned-from-template plan (§5.8) is
/// its own row with `clientId` set and `professionalId` still null,
/// `authoredById` carried over from the template it was cloned from.
model TrainingPlan {
  id             String             @id @default(cuid())
  clientId       String?
  client         User?              @relation("TrainingPlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   User?              @relation("TrainingPlanProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  authoredById   String?
  authoredBy     User?              @relation("TrainingPlanAuthor", fields: [authoredById], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime           @db.Date
  status         TrainingPlanStatus @default(DRAFT)
  isStarterTemplate Boolean         @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  mesocycles Mesocycle[]

  @@index([clientId])
  @@index([professionalId])
  @@index([isStarterTemplate])
  @@map("training_plans")
}

/// A training block within a plan (PRD 06 §5.2/§6). Deliberately has no
/// `startDate` of its own — its effective start date is always computed as
/// `trainingPlan.startDate + sum(weeks of mesocycles with a lower order)`
/// (§6), so resizing/reordering an earlier mesocycle correctly shifts every
/// later one without a manual date-patching step. `order` is server-assigned
/// (next integer after the plan's current max), never client-supplied, so
/// it stays a total order with no gaps/conflicts to reconcile.
model Mesocycle {
  id             String        @id @default(cuid())
  trainingPlanId String
  trainingPlan   TrainingPlan  @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  order          Int
  weeks          Int
  goal           MesocycleGoal
  isDeload       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  weeklyTemplates WeeklyMicrocycleTemplate[]
  sessions        Session[]

  @@unique([trainingPlanId, order])
  @@map("mesocycles")
}

/// One weekday's prescribed session within a mesocycle (PRD 06 §5.3/§6).
/// Simplified from §6's literal "weekday → sessionTemplate mapping" wording:
/// v1 has no cross-weekday template reuse (each weekday owns its own
/// exercise list outright, even if two weekdays end up identical) — the
/// indirection of a separately-reusable "SessionTemplate" object isn't
/// needed for what the UI actually does (fill out each weekday's session
/// individually) and would only add an unused reuse mechanism. Saving this
/// (§5.4) generates dated `Session` instances for the mesocycle's span; the
/// generation is additive-only — it never touches a `date` slot that
/// already has a generated `Session` row, so re-saving after a Client has
/// already seen/logged sessions can't silently rewrite them.
model WeeklyMicrocycleTemplate {
  id          String    @id @default(cuid())
  mesocycleId String
  mesocycle   Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  weekday     Weekday
  /// Display label for this weekday's session, e.g. "Push Day A".
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exercises WeeklyMicrocycleTemplateExercise[]

  @@unique([mesocycleId, weekday])
  @@map("weekly_microcycle_templates")
}

/// One prescribed exercise within a weekday template (PRD 06 §5.5/§6).
/// `targetRepsMin`/`targetRepsMax` model "reps (or rep range)" as two ints
/// (max null = a single fixed rep count) rather than a free-text field, to
/// stay queryable/structured — same reasoning as PRD 03's `PainFlag` being a
/// real table instead of free-form Json. `targetRpe`/`targetRir` are two
/// separate nullable fields (mutually exclusive, same pattern as
/// `targetLoad`/`targetPercent1RM`) rather than one value + a scale-type
/// enum — RPE and RIR are different scales, so which one is set says which
/// scale the Professional prescribed in (base doc §3.3 — autoregulated
/// prescription).
model WeeklyMicrocycleTemplateExercise {
  id                         String                   @id @default(cuid())
  weeklyMicrocycleTemplateId String
  weeklyMicrocycleTemplate   WeeklyMicrocycleTemplate @relation(fields: [weeklyMicrocycleTemplateId], references: [id], onDelete: Cascade)
  exerciseId                 String
  exercise                   Exercise                 @relation(fields: [exerciseId], references: [id])
  order                      Int
  targetSets                 Int
  targetRepsMin              Int
  targetRepsMax              Int?
  targetLoad                 Float?
  targetPercent1RM           Float?
  targetRpe                  Float?
  targetRir                  Float?
  restSeconds                Int?
  tempo                      String?
  notes                      String?

  @@index([weeklyMicrocycleTemplateId])
  @@map("weekly_microcycle_template_exercises")
}

/// One dated occurrence, auto-generated from a `WeeklyMicrocycleTemplate`
/// (PRD 06 §5.4/§6). `@@unique([mesocycleId, date])` is what makes
/// generation idempotent — a slot that already has a row is left untouched.
/// `status` also carries `MISSED`, which only PRD 07's auto-flag job ever
/// sets (§6 cross-reference) — this module only ever writes `SCHEDULED` or
/// `CANCELLED`.
model Session {
  id                     String        @id @default(cuid())
  mesocycleId            String
  mesocycle              Mesocycle     @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  date                   DateTime      @db.Date
  /// Set when a Professional moves this session to a different date (§5.4)
  /// — preserves the template-implied date for audit/history.
  originalDate           DateTime?     @db.Date
  status                 SessionStatus @default(SCHEDULED)
  /// True once this instance's date or exercises were manually edited away
  /// from what the template would generate (§5.4).
  overriddenFromTemplate Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  sessionExercises SessionExercise[]

  @@unique([mesocycleId, date])
  @@index([mesocycleId, status])
  @@map("sessions")
}

/// One exercise within a dated Session (PRD 06 §5.5/§6) — an independent
/// copy made from `WeeklyMicrocycleTemplateExercise` at generation time, not
/// a live reference, so editing this one instance (§5.4's "edit exercises"
/// override) can never affect the template or any other generated session.
model SessionExercise {
  id                String   @id @default(cuid())
  sessionId         String
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise @relation(fields: [exerciseId], references: [id])
  order             Int
  targetSets        Int
  targetRepsMin     Int
  targetRepsMax     Int?
  targetLoad        Float?
  targetPercent1RM  Float?
  targetRpe         Float?
  targetRir         Float?
  restSeconds       Int?
  tempo             String?
  notes             String?

  exerciseLogs ExerciseLog[]

  @@index([sessionId])
  @@map("session_exercises")
}


// --- PRD 04: Body Assessment ------------------------------------------------

enum BodyAssessmentSource {
  SELF_REPORTED
  PROFESSIONAL_VALIDATED
}

enum BodyFatSource {
  COMPUTED_POLLOCK7
  MANUAL_OVERRIDE
}

// §5.2's "structured goal type" — a real scalar column, so a genuine Prisma
// enum (unlike circumferences/skinfolds/postureScreening below, which stay
// Json and are validated by packages/validation's zod schemas only, since
// none of their sub-fields need to be a real Prisma column type anywhere
// else — that's what makes the PRD 03 "BodyRegion silently omitted from
// @prisma/client because it was only ever referenced inside a Json field"
// trap not apply here: we simply never declare a DB enum for a value that's
// only ever nested inside Json).
enum BodyAssessmentGoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
  PERFORMANCE
  REHABILITATION
  OTHER
}

/// Append-only clinical measurement history (PRD 04 §5.4/§6). Enforced at the
/// repository layer (base doc §7.2), not a DB trigger — BodyAssessmentRepository
/// (apps/api/src/body-assessments/domain/ports) exposes no update/delete
/// method at all, so a misuse would be a compile error, not a runtime check.
/// `circumferences`/`skinfolds`/`postureScreening`/`photos` are Json per PRD
/// 04 §6's own field-list formatting — see the BodyAssessmentGoalType comment
/// above for why that's safe here (none of their sub-fields are DB enums).
/// `photos` stores object-storage *keys* only (`[{ key, tag }]`), never a
/// URL — signed, time-limited GET URLs are minted at serialize time (§5.7).
model BodyAssessment {
  id            String               @id @default(cuid())
  clientId      String
  client        User                 @relation("BodyAssessmentClient", fields: [clientId], references: [id], onDelete: Cascade)
  source        BodyAssessmentSource
  validatedById String?
  validatedBy   User?                @relation("BodyAssessmentValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  recordedAt    DateTime             @default(now())
  /// "pollock7-v1" (§5.6) for PROFESSIONAL_VALIDATED rows; null for
  /// SELF_REPORTED (no protocol applies to a quick weight log).
  protocolVersion String?

  weight Float
  height Float?
  bmi    Float?

  /// { neck, chest, waist, hip, armRelaxed, armFlexed, thigh, calf, bilateral? } (cm)
  circumferences Json?
  waistHipRatio  Float?
  /// { chest, midaxillary, triceps, subscapular, abdominal, suprailiac, thigh } (mm)
  skinfolds        Json?
  bodyFatPercent   Float?
  bodyFatSource    BodyFatSource?
  /// Required by the Application-layer rule whenever bodyFatSource is
  /// MANUAL_OVERRIDE (§5.2) — enforced by packages/validation's zod schema,
  /// not a DB constraint (same "conditional requirement lives above the DB"
  /// pattern as this codebase's other modules).
  bodyFatOverrideNote String?
  /// Structured posture-screening checklist (§5.2) — string-literal fields,
  /// validated by zod, not DB enums (see model-level comment above).
  postureScreening Json?
  photos           Json?

  goalType        BodyAssessmentGoalType?
  goalTargetValue Float?
  goalTargetDate  DateTime?               @db.Date
  goalNote        String?

  /// Optional free-text note on a SELF_REPORTED entry (§5.1) — distinct from
  /// goalNote, which only applies to a formal assessment's goal section.
  note String?

  createdAt DateTime @default(now())

  @@index([clientId, recordedAt])
  @@map("body_assessments")
}

// --- PRD 07: Client Training Execution ---------------------------------------

/// One logged set of an exercise, recorded by the Client against one dated
/// Session (§5.2/§6). `setNumber` is server-assigned — the count of existing
/// logs for this `sessionExerciseId` plus one — so the Client's UI is just
/// "log the next set", no manual numbering. `loggedAt` is the real-world
/// moment it was recorded, deliberately independent of the parent
/// `Session.date`: a Client logging Monday's session on Tuesday (§5.4 "late
/// logging") must never be conflated with the session's target date, or
/// adherence reporting couldn't tell the two apart.
///
/// `sessionExerciseId`'s FK is the Prisma-default Restrict (left unset) —
/// the same "logged history outlives a later edit" precedent as
/// `WeeklyMicrocycleTemplateExercise`/`SessionExercise` → `Exercise` (PRD 06
/// §6): a Professional replacing a Session's exercises (PRD 06 §5.4,
/// `ReplaceSessionExercisesUseCase`, which wipes and recreates
/// `SessionExercise` rows) must never be able to silently destroy a
/// Client's already-logged performance by deleting the row it's attached
/// to. `PrismaSessionRepository.replaceExercises` now catches that FK's
/// P2003 and surfaces a 409 instead — found while verifying this phase live
/// (see the Phase 9 checklist note).
model ExerciseLog {
  id                String          @id @default(cuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id])
  setNumber         Int
  actualReps        Int
  actualLoad        Float?
  actualRpeOrRir    Float?
  note              String?
  loggedAt          DateTime        @default(now())

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId])
  @@map("exercise_logs")
}

// --- PRD 08: Nutrition Module ------------------------------------------------

enum NutritionPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// §5.1/§5.2 — a calorie/macro target. Created as DRAFT by the
/// Mifflin-St-Jeor estimate (system- or Nutritionist-triggered); never
/// visible to the Client, never touched by any background job, until a
/// Nutritionist explicitly confirms it (ACTIVE + confirmedByProfessionalAt
/// set in the same write — §3's Non-Goal: no code path may set one without
/// the other). A Client-facing query must filter to ACTIVE only; this is
/// enforced in the Application layer (NutritionAccess/serializer), not the
/// schema — same "conditional/visibility rule lives above the DB" pattern
/// this codebase uses throughout (e.g. PRD 04's bodyFatOverrideNote).
model NutritionPlan {
  id                       String              @id @default(cuid())
  clientId                 String
  client                   User                @relation("NutritionPlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  nutritionistId           String
  nutritionist             User                @relation("NutritionPlanNutritionist", fields: [nutritionistId], references: [id], onDelete: Cascade)
  calorieTarget            Int
  /// { protein, carbs, fat } in grams.
  macroTargets             Json
  status                   NutritionPlanStatus @default(DRAFT)
  confirmedByProfessionalAt DateTime?
  /// §5.2's optional structured meal plan — meal slots with suggested
  /// foods, Nutritionist-authored. Nullable Json rather than a child table:
  /// it's an optional, wholly-replaced-on-edit attachment with no field
  /// that needs to be queried/joined on its own, unlike e.g. skinfolds'
  /// per-site structure.
  mealPlan                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([clientId, status])
  @@map("nutrition_plans")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// §5.3/§6 — one logged food entry. `nutrientsSnapshot` is a full copy of
/// the resolved FoodItemCache entry's nutrients *at log time*, deliberately
/// duplicated rather than joined — a later correction to the cache row (a
/// re-fetch, a manual fix) must never retroactively change what a historical
/// entry displays (§10 AC, "snapshot immutability").
model FoodDiaryEntry {
  id                String   @id @default(cuid())
  clientId          String
  client            User     @relation("FoodDiaryEntryClient", fields: [clientId], references: [id], onDelete: Cascade)
  foodItemCacheId   String?
  foodItemCache     FoodItemCache? @relation(fields: [foodItemCacheId], references: [id])
  /// Free-text label for a manual-entry fallback (no matching cache row —
  /// e.g. Open Food Facts "not found", §5.3/§7).
  customFoodName    String?
  quantity          Float
  mealSlot          MealSlot
  loggedAt          DateTime @default(now())
  /// { calories, protein, carbs, fat } for the logged quantity — captured at
  /// log time, see model comment above.
  nutrientsSnapshot Json

  @@index([clientId, loggedAt])
  @@map("food_diary_entries")
}

enum FoodSource {
  OPEN_FOOD_FACTS
  USDA
  CUSTOM
}

/// §5.3/§6 — the normalization layer both external food APIs write through
/// (base doc §7.5 caching architecture), so a Client's search/scan
/// experience doesn't depend on live third-party latency after the first
/// lookup. Unique on (source, externalId) so a repeat lookup of the same
/// barcode/fdcId hits the cache instead of duplicating a row — same
/// idempotency reasoning as PRD 05's Exercise import keying on sourceApiId.
model FoodItemCache {
  id         String     @id @default(cuid())
  source     FoodSource
  externalId String
  name       String
  /// Per-100g (Open Food Facts) or per-serving (USDA) — { calories, protein,
  /// carbs, fat } plus whichever basis applies; the normalization adapter
  /// records which so a diary entry's quantity math stays correct.
  nutrients  Json
  fetchedAt  DateTime   @default(now())

  diaryEntries FoodDiaryEntry[]

  @@unique([source, externalId])
  @@map("food_item_cache")
}

/// §5.4 — one Client's water-intake count for one calendar day. A simple
/// per-day upsertable row (not a per-glass event log) — the PRD only asks
/// for a running daily counter, not a timestamped history of each glass.
model HydrationLog {
  id       String   @id @default(cuid())
  clientId String
  client   User     @relation("HydrationLogClient", fields: [clientId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  /// Count of logged units (e.g. 250ml glasses) for this day.
  amount   Int      @default(0)

  @@unique([clientId, date])
  @@map("hydration_logs")
}

// --- PRD 11: Messaging ----------------------------------------------------

enum MessageThreadStatus {
  ACTIVE
  READ_ONLY
}

/// PRD 11 §6 — a real, explicit entity with its own id (the "no separate
/// setup step" language in §5.1 describes the UX, not the data model).
/// Created (or synced) the moment the underlying ProfessionalClientLink
/// (PRD 02) becomes ACTIVE or UNLINKED, via the LINK_STATUS_CHANGED domain
/// event RelationshipsModule emits — see
/// relationships/application/use-cases/{accept-link,unlink,force-unlink}
/// .use-case.ts and messaging/infrastructure/link-status-changed-listener
/// .service.ts. Keyed on the (professionalId, clientId) pair, not the link
/// row or its specialization — §5.1's "a Client linked to both a PT and a
/// Nutritionist gets two independent threads, one per Professional" falls
/// out naturally from a pair-level unique constraint rather than needing
/// special-casing per specialization.
model MessageThread {
  id             String              @id @default(cuid())
  professionalId String
  professional   User                @relation("MessageThreadProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  clientId       String
  client         User                @relation("MessageThreadClient", fields: [clientId], references: [id], onDelete: Cascade)
  status         MessageThreadStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages Message[]

  @@unique([professionalId, clientId])
  @@map("message_threads")
}

/// PRD 11 §6/§5.4 — plain text only; the API stores/returns the raw string
/// as-is, the never-render-raw-HTML discipline is a frontend rendering rule
/// (React's default text rendering already escapes everything — the real
/// risk is only introduced if a future change adds
/// dangerouslySetInnerHTML). `attachments` is reserved, unused in v1 (§8
/// fast-follow). `readAt` is nullable and unambiguous because a thread
/// always has exactly one other party — it's set when that other party
/// reads the message, never the sender's own.
model Message {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body        String
  attachments Json          @default("[]")
  sentAt      DateTime      @default(now())
  readAt      DateTime?

  @@index([threadId, sentAt])
  @@map("messages")
}

// --- PRD 10: Productivity / Habits (health-adjacent, Client-only) -----------

enum HabitCadence {
  DAILY
  SPECIFIC_WEEKDAYS
}

/// PRD 10 §6/§5.1 — one Client's custom health-adjacent habit ("stretch
/// 10 min", "take vitamin D"). Client-only by design (§4) — the only FK
/// here is into users; deliberately NO FK into TrainingPlan/NutritionPlan/
/// BodyAssessment (§10's isolation AC is proven by a schema-level BDD
/// scenario). `weekdays` reuses PRD 06's Weekday enum vocabulary and is
/// only meaningful under SPECIFIC_WEEKDAYS — under DAILY every calendar
/// day is a due day. `archivedAt` is the soft-delete: archiving hides the
/// habit from today's checklist but keeps its check-in history.
model HabitDefinition {
  id           String       @id @default(cuid())
  clientId     String
  client       User         @relation("HabitClient", fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  cadence      HabitCadence @default(DAILY)
  weekdays     Weekday[]    @default([])
  /// Optional "HH:MM" time-of-day — a display hint only in v1 (reminder
  /// delivery belongs to PRD 12, not here). A plain String, not @db.Time:
  /// a bare time-of-day has no timezone to pin, and Postgres `time` would
  /// surface in the Prisma client as a 1970-dated DateTime anyway.
  reminderTime String?
  createdAt    DateTime     @default(now())
  archivedAt   DateTime?

  checkIns HabitCheckIn[]

  @@index([clientId])
  @@map("habit_definitions")
}

/// PRD 10 §6/§5.2 — one check-off of one habit on one calendar day.
/// @@unique(habitDefinitionId, date) makes "check off" naturally
/// idempotent (a double-tap upserts, never duplicates). Append-only
/// history: a missed day resets the streak but never deletes past
/// check-ins (§10).
model HabitCheckIn {
  id                String          @id @default(cuid())
  habitDefinitionId String
  habit             HabitDefinition @relation(fields: [habitDefinitionId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  checkedAt         DateTime        @default(now())

  @@unique([habitDefinitionId, date])
  @@map("habit_check_ins")
}

/// PRD 10 §6/§5.3 — a flat personal to-do: text, optional due date,
/// done/not-done. No sub-tasks, no priorities, no sharing (§3). Hard
/// delete is fine — §6 defines no archivedAt and a finished/deleted task
/// carries no history worth preserving, unlike a habit's check-in trail.
model PersonalTask {
  id          String    @id @default(cuid())
  clientId    String
  client      User      @relation("PersonalTaskClient", fields: [clientId], references: [id], onDelete: Cascade)
  text        String
  dueDate     DateTime? @db.Date
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([clientId])
  @@map("personal_tasks")
}

// --- PRD 12: Notifications --------------------------------------------------

/// One row per §5.1 trigger event, including the two account-security types
/// (EMAIL_VERIFICATION/PASSWORD_RESET) which §5.1 keeps in the in-app list
/// even though they bypass the preference/dispatcher path entirely.
enum NotificationType {
  SESSION_REMINDER
  MISSED_SESSION
  MISSED_FOOD_LOG
  NEW_MESSAGE
  PLAN_UPDATED
  TRAINING_PLAN_CREATED
  WEEKLY_SUMMARY_READY
  CHECK_IN_DUE
  APPROVAL_DECISION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// §5.4/§6 — every trigger writes exactly one Notification per intended
/// recipient regardless of channel opt-outs: this table is the in-app
/// notification list (§7) AND the read model behind PRD 09's unread
/// indicators, so channel preferences can never suppress the row itself.
/// `payload` carries the event-specific context plus the rendered
/// title/body the dispatcher computed at dispatch time.
///
/// `dedupeKey` is the exactly-once marker for scheduler-fired triggers
/// (§10 AC "exactly one Notification per intended recipient"): jobs tick
/// every minute and re-see the same firing condition until their
/// state advances, so the dispatcher computes a deterministic key per
/// occurrence (e.g. `session:{id}`, `foodlog:{clientId}:{date}`,
/// `week:{clientId}:{weekStart}`, `plan:{planId}:{yyyy-mm-dd}` — the
/// last one deliberately per-day so a Professional's multi-edit session
/// can't spam the Client, §2's "non-spammy" goal). NULL for
/// action-triggered notifications, where each user action is already
/// naturally one event; Postgres treats NULLs as distinct, so those rows
/// never collide under the unique constraint. P2002 on insert means
/// "already notified" — the dispatcher swallows it and skips delivery.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, type, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

/// §5.3/§6 — per-user, per-trigger-type channel toggles for the
/// preference-eligible types only (§5.1.1): a row exists only once the
/// user has changed a toggle away from the defaults (absence = defaults,
/// both channels on). ACCOUNT_SECURITY types never have a row — they
/// bypass the preference system entirely (§5.1), not merely locked-on.
/// APPROVAL_DECISION is account-critical: emailEnabled is enforced
/// server-side as always-true for it (§5.3/§10), not just hidden in UI.
model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  emailEnabled Boolean          @default(true)
  pushEnabled  Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, type])
  @@map("notification_preferences")
}

/// §5.2 — one row per browser PushManager subscription the user has
/// granted. Optional channel: when VAPID keys aren't configured or the
/// user never subscribes, delivery silently falls back to email-only and
/// this table simply stays empty. `endpoint` is the browser's unique
/// subscription URL; `keys` holds { p256dh, auth } for payload encryption.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
