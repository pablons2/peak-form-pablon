// PeakForm — Prisma schema
// Models are added module by module, in the order tracked in
// docs/IMPLEMENTATION_CHECKLIST.md (PRD 01 first). Do not add a model here
// before its owning PRD's "Backend" checklist item is being worked on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- PRD 01: Authentication & Account Management -------------------------

enum Role {
  ADMIN
  PROFESSIONAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum Specialization {
  PERSONAL_TRAINER
  NUTRITIONIST
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BiologicalSex {
  MALE
  FEMALE
}

/// Base identity for every persona (base doc §6). `fullName` is not listed
/// explicitly on User in PRD 01 §6 (only called out as a Professional signup
/// field there), but every persona needs a display name — messaging (PRD 11),
/// the admin console (PRD 13), and professional/client lists (PRD 02) all
/// depend on it — so it lives here as a base field rather than being
/// duplicated per-role.
model User {
  id                         String     @id @default(cuid())
  email                      String     @unique
  fullName                   String
  passwordHash               String?
  oauthProviders             String[]   @default([])
  role                       Role
  status                     UserStatus @default(ACTIVE)
  emailVerifiedAt            DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  /// Time-limited email-verification token (PRD 01 §5.2). Stored as a hash,
  /// never the raw token, per base doc §9's secrets-handling guidance — the
  /// raw token only ever exists in the emailed link. No new top-level entity
  /// per PRD 01 §6, so these live as fields on User rather than their own table.
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  /// Time-limited password-reset token (PRD 01 §5.4), same hash-not-raw rule.
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?

  /// Bumped on every password reset; a JWT's embedded version must match this
  /// or the token is rejected. This is how "password reset invalidates all
  /// prior sessions" (PRD 01 §10) is enforced against stateless access/refresh
  /// JWTs without a server-side session table.
  tokenVersion               Int        @default(0)

  professionalProfile        ProfessionalProfile?
  clientProfile               ClientProfile?

  /// Professional accounts this user approved/rejected as Admin (PRD 01 §5.6).
  approvalDecisions          ProfessionalProfile[] @relation("ApprovalActor")

  /// PRD 02 — links where this user is the Professional / Client side, links
  /// this user unlinked, and check-in schedules this user created.
  professionalLinks         ProfessionalClientLink[] @relation("LinkProfessional")
  clientLinks               ProfessionalClientLink[] @relation("LinkClient")
  unlinkedLinks             ProfessionalClientLink[] @relation("LinkUnlinker")
  createdCheckInSchedules   CheckInSchedule[]        @relation("CheckInScheduleCreator")

  auditLogEntries            AuditLog[]

  @@map("users")
}

/// 1:1 with a PROFESSIONAL User (PRD 01 §6).
model ProfessionalProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations  Specialization[]
  approvalStatus   ApprovalStatus  @default(PENDING_APPROVAL)
  verificationNote String
  approvedById     String?
  approvedBy       User?           @relation("ApprovalActor", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("professional_profiles")
}

/// 1:1 with a CLIENT User (PRD 01 §6). dateOfBirth/biologicalSex are required
/// — they feed PRD 04's Jackson & Pollock formula and PRD 08's Mifflin-St
/// Jeor estimate; age is always computed from dateOfBirth at calculation
/// time, never stored, so no separate "age" field exists here.
model ClientProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth   DateTime      @db.Date
  biologicalSex BiologicalSex
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("client_profiles")
}

/// Append-only compliance/accountability trail (base doc §6, §9). First
/// consumer is PRD 01 §5.6 (approval/rejection decisions); later modules
/// (PRD 02 force-unlink, PRD 06 contraindication overrides, PRD 13 admin
/// actions) write to the same table rather than each owning their own log.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}


// --- PRD 02: Professional ↔ Client Relationship ---------------------------

enum LinkStatus {
  PENDING
  ACTIVE
  DECLINED
  EXPIRED
  UNLINKED
}

enum LinkInvitedBy {
  PROFESSIONAL
  CLIENT
}

/// The working relationship between a Professional and a Client for one
/// specialization (PRD 02 §6). The invite/request IS this row in PENDING;
/// it goes straight to ACTIVE on acceptance (no separate ACCEPTED status).
/// "At most one ACTIVE row per (clientId, specialization)" (PRD 02 §6) is
/// enforced in the Application layer (§5.3) rather than as a DB constraint,
/// because history rows (DECLINED/EXPIRED/UNLINKED) for the same key are
/// legitimate and a partial unique index isn't expressible here.
model ProfessionalClientLink {
  id             String         @id @default(cuid())
  professionalId String
  professional   User           @relation("LinkProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  clientId       String
  client         User           @relation("LinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  specialization Specialization
  status         LinkStatus     @default(PENDING)
  invitedBy      LinkInvitedBy

  /// PENDING invites auto-expire to EXPIRED after 30 days (PRD 02 §5.1);
  /// cleared on acceptance.
  expiresAt DateTime?

  linkedAt     DateTime?
  unlinkedAt   DateTime?
  unlinkedById String?
  unlinkedBy   User?     @relation("LinkUnlinker", fields: [unlinkedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkInSchedules CheckInSchedule[]

  @@index([clientId, specialization, status])
  @@index([professionalId, status])
  @@map("professional_client_links")
}

enum CheckInScheduleType {
  ONE_OFF
  RECURRING
}

enum CheckInCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum CheckInScheduleStatus {
  ACTIVE
  FIRED
  CANCELLED
}

/// Check-in reminder owned by PRD 02 §5.6, scoped to one
/// ProfessionalClientLink (a PT and a Nutritionist schedule independently).
/// `nextDueAt` is the firing job's query target (status ACTIVE + due) and the
/// single source of truth PRD 09's dashboard and PRD 12's notification both read.
model CheckInSchedule {
  id     String              @id @default(cuid())
  linkId String
  link   ProfessionalClientLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  type    CheckInScheduleType
  /// Required only for RECURRING (WEEKLY/BIWEEKLY: weekday 0-6; MONTHLY:
  /// day-of-month 1-31, clamped to the month's length in date-math).
  cadence CheckInCadence?
  anchor  Int?
  /// Required only for ONE_OFF.
  dueDate DateTime?
  /// Computed from cadence+anchor (RECURRING) or dueDate (ONE_OFF); indexed
  /// because this is what the firing job queries (PRD 02 §5.6).
  nextDueAt DateTime?
  note      String?
  status    CheckInScheduleStatus @default(ACTIVE)

  createdById String
  /// Cascade (not the Prisma default Restrict): a CheckInSchedule's `link`
  /// FK already cascades from either party via ProfessionalClientLink, so a
  /// Restrict here would still block that same delete outright the moment
  /// the creator (always one of the link's two parties) is the target —
  /// conflicting FK actions on the same row, not two independent rules.
  createdBy User @relation("CheckInScheduleCreator", fields: [createdById], references: [id], onDelete: Cascade)

  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextDueAt])
  @@index([linkId, status])
  @@map("check_in_schedules")
}
