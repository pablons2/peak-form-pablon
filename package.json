{
  "name": "peakform",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=@peakform/api",
    "test:frontend": "turbo run test --filter=@peakform/web"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=20"
  }
}
